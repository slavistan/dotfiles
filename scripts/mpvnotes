#!/usr/bin/env python3
"""Timestamped notes for an mpv stream, written in nvim.

mpv runs in a terminal split below the notes file and is additionally driven
over an IPC socket, so that nvim knows the playback position. Inside the split
mpv's own controls apply (input.conf); the notes buffer has a handful of
buffer-local hotkeys -- <F1> lists them, mpvnotes.lua defines them.

The notes file is always created in the current working directory, never next
to the source -- notes belong where you are working:

    mpvnotes episode-42.mp3               # -> ./episode-42.txt
    mpvnotes --notes thoughts.txt x.mp3   # -> ./thoughts.txt
    mpvnotes https://host/pod.mp3         # -> ./https%3A%2F%2Fhost%2Fpod.mp3.txt

An existing file is opened and written on, there is no numbering. URLs are
percent-encoded so the file name preserves the source losslessly. Only if that
exceeds the 255 byte name limit is it truncated and a hash appended.

Everything after the source is passed to mpv unchanged:

    mpvnotes talk.mp4 --start=10:00 --no-video
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import quote

LUA = Path(__file__).resolve().with_name("mpvnotes.lua")
URL_RE = re.compile(r"^[a-zA-Z][a-zA-Z0-9+.-]*://")
NAME_MAX = 255  # Bytes pro Pfadkomponente


def die(msg: str) -> None:
    sys.exit(f"mpvnotes: {msg}")


def clamp(stem: str) -> str:
    """Shorten over-long names, appending a hash so they stay unique.

    In practice this only hits signed direct links (CDN tokens), which grow
    past the limit quickly once percent-encoded. Reversibility of the name is
    lost in that case, uniqueness is not.
    """
    limit = NAME_MAX - len(".txt")
    raw = stem.encode()
    if len(raw) <= limit:
        return stem
    tag = "-" + hashlib.sha256(raw).hexdigest()[:8]
    return raw[: limit - len(tag)].decode("utf-8", "ignore") + tag


def notes_path(source: str, explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser()
    stem = quote(source, safe="") if URL_RE.match(source) else Path(source).stem
    if not stem:
        die(f"cannot derive a notes name from '{source}', use --notes")
    return Path(clamp(stem) + ".txt")


def main() -> None:
    argv = sys.argv[1:]
    notes: str | None = None
    while argv:
        if argv[0] in ("-h", "--help"):
            print(__doc__.strip())
            return
        if argv[0] == "--notes":
            if len(argv) < 2:
                die("--notes needs a path")
            notes, argv = argv[1], argv[2:]
        elif argv[0].startswith("--notes="):
            notes, argv = argv[0].split("=", 1)[1], argv[1:]
        else:
            break

    if not argv:
        die("no source given (file or URL); --help shows the usage")
    source, mpv_args = argv[0], argv[1:]
    if source.startswith("-"):
        die(f"'{source}' looks like an option -- mpv options go after the source")
    is_url = bool(URL_RE.match(source))
    if not is_url and not Path(source).expanduser().is_file():
        die(f"no such file: {source}")
    if not LUA.is_file():
        die(f"missing: {LUA}")

    target = notes_path(source, notes)
    target.parent.mkdir(parents=True, exist_ok=True)

    # execvp behaelt unsere PID, der Socketname passt hinterher also weiterhin.
    sock = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / f"mpvnotes-{os.getpid()}.sock"
    sock.unlink(missing_ok=True)  # Rest eines Vorgaengers mit derselben PID

    os.environ["MPVNOTES_JSON"] = json.dumps({
        "lua": str(LUA),
        "socket": str(sock),
        "source": source if is_url else str(Path(source).expanduser()),
        "mpv_args": mpv_args,
    })
    os.execvp("nvim", [
        "nvim",
        "-c", "lua dofile(vim.json.decode(vim.env.MPVNOTES_JSON).lua)",
        str(target),
    ])


if __name__ == "__main__":
    main()
